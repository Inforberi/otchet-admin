# База данных
DATABASE_URL="postgresql://admin:password@localhost:5455/admin_panel?schema=public"

# Порт приложения
PORT=3000

# Директория для загрузок
UPLOAD_DIR="./uploads"

# Максимальный размер загружаемого файла (в байтах, 10MB)
MAX_UPLOAD_SIZE=10485760

# Авторизация (пользователи в БД: /setup — первый super-admin, /login — вход)
JWT_SECRET="change-me-in-production"
SETUP_CODE="your-setup-code-here"
RECOVERY_PHRASE="your-recovery-phrase-here"

# Database port (used by docker-compose and scripts)
DB_PORT=5455
