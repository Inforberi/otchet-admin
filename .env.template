# База данных
POSTGRES_USER="admin"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="admin_panel"

# Локальная разработка (make dev + docker-compose.dev.yml)
POSTGRES_HOST_PORT=5455
DATABASE_URL="postgresql://admin:change-me@localhost:5455/admin_panel?schema=public"

# Порт приложения
APP_BIND_IP="127.0.0.1"
APP_PORT=3033

# Директория для загрузок
UPLOAD_DIR="./uploads"

# Базовый URL для Playwright при генерации PDF (fallback для картинок по HTTP)
# Локальная разработка (pnpm dev): порт вашего dev-сервера, например 3033
# Docker (compose): внутри контейнера приложение на 3000 — задаётся в docker-compose.yml
PDF_INTERNAL_BASE_URL="http://127.0.0.1:3033"

# Максимальный размер загружаемого файла (в байтах, 10MB)
MAX_UPLOAD_SIZE=10485760

# Авторизация (пользователи в БД: /setup — первый super-admin, /login — вход)
JWT_SECRET="change-me-in-production"
SETUP_CODE="your-setup-code-here"
RECOVERY_PHRASE="your-recovery-phrase-here"

# Cookie сессии: false для HTTP (например http://192.168.x.x:3002), true за HTTPS/nginx
COOKIE_SECURE=false
