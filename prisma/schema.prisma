// Prisma schema для админ-панели отчетов

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Группы отчетов
model ReportGroup {
  id          String        @id @default(uuid())
  name        String        // название группы (например, "Отчеты по сайту", "Документация")
  slug        String        // локальный URL-friendly slug в рамках родителя
  path        String        @unique // полный путь группы, например "otchety/seo"
  description String?       // описание группы
  order       Int           @default(0) // порядок отображения
  parentId    String?       @map("parent_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  parent      ReportGroup?  @relation("ReportGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ReportGroup[] @relation("ReportGroupTree")
  reports     Report[]
  uploads     Upload[]

  @@map("report_groups")
  @@index([parentId])
  @@index([slug])
}

// Отчеты
model Report {
  id                String   @id @default(uuid())
  title             String
  slug              String   // URL-friendly название (например, "otchet-studia-54")
  subtitle          String?
  client            String?
  date              String?
  status            String   @default("draft") // draft | published
  titleFontSize     String?  @default("40") @map("title_font_size") // размер шрифта заголовка в px
  descriptionFontSize String? @default("20") @map("description_font_size") // размер шрифта описания в px
  captionFontSize   String?  @default("16") @map("caption_font_size") // размер шрифта подписи к изображениям в px
  groupId           String   @map("group_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  group       ReportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  blocks      ReportBlock[]

  @@map("reports")
  @@index([groupId])
  @@unique([groupId, slug]) // slug уникален в рамках группы
}

// Блоки внутри отчета
model ReportBlock {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  type      String   // text | screenshot
  position  Int      // порядок блока
  data      Json     // содержимое блока (title, content, images, layout, etc.)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_blocks")
  @@index([reportId])
}

// Метаданные загруженных файлов (изображения)
model Upload {
  id        String   @id @default(uuid())
  reportId  String?  @map("report_id")
  groupId   String   @map("group_id")
  filename  String
  path      String   @unique // относительный путь на сервере
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  group      ReportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("uploads")
  @@index([reportId])
  @@index([groupId])
}
