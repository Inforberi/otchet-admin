// Prisma schema для админ-панели отчетов

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppRole {
  id              String   @id @default(uuid())
  name            String   @unique
  canEditContent  Boolean  @default(false) @map("can_edit_content")
  canManageUsers  Boolean  @default(false) @map("can_manage_users")
  isSystem        Boolean  @default(false) @map("is_system")
  restrictGroups  Boolean  @default(false) @map("restrict_groups")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  groupAccess AppRoleGroup[]
  users       User[]

  @@map("app_roles")
}

model AppRoleGroup {
  roleId  String @map("role_id")
  groupId String @map("group_id")

  role  AppRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  group ReportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([roleId, groupId])
  @@map("app_role_groups")
  @@index([groupId])
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  firstName          String   @map("first_name")
  lastName           String   @map("last_name")
  appRoleId          String   @map("app_role_id")
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  isActive           Boolean  @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  appRole AppRole @relation(fields: [appRoleId], references: [id], onDelete: Restrict)

  @@map("users")
  @@index([appRoleId])
  @@index([isActive])
}

// Группы отчетов
model ReportGroup {
  id          String        @id @default(uuid())
  name        String        // название группы (например, "Отчеты по сайту", "Документация")
  slug        String        // локальный URL-friendly slug в рамках родителя
  path        String        @unique // полный путь группы, например "otchety/seo"
  description String?       // описание группы
  order       Int           @default(0) // порядок отображения
  parentId    String?       @map("parent_id")
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  parent      ReportGroup?  @relation("ReportGroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ReportGroup[] @relation("ReportGroupTree")
  reports     Report[]
  uploads     Upload[]
  roleAccess  AppRoleGroup[]

  @@map("report_groups")
  @@index([parentId])
  @@index([slug])
}

// Отчеты
model Report {
  id                String   @id @default(uuid())
  title             String
  slug              String   // URL-friendly название (например, "otchet-studia-54")
  subtitle          String?
  client            String?
  date              String?
  status            String   @default("draft") // draft | published
  titleFontSize     String?  @default("40") @map("title_font_size") // размер шрифта заголовка в px
  descriptionFontSize String? @default("20") @map("description_font_size") // размер шрифта описания в px
  contentHeadingFontSize String? @default("24") @map("content_heading_font_size") // пресет «Заголовок» в тексте блока, px
  captionFontSize   String?  @default("16") @map("caption_font_size") // размер шрифта подписи к изображениям в px
  groupId           String   @map("group_id")
  version           Int      @default(1)
  draftHash         String?  @map("draft_hash")
  publishedHash     String?  @map("published_hash")
  publishedSnapshot Json?    @map("published_snapshot")
  publishedAt       DateTime? @map("published_at")
  draftUpdatedAt    DateTime? @map("draft_updated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  group       ReportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  blocks      ReportBlock[]

  @@map("reports")
  @@index([groupId])
  @@unique([groupId, slug]) // slug уникален в рамках группы
}

// Блоки внутри отчета
model ReportBlock {
  id                    String    @id @default(uuid())
  reportId              String    @map("report_id")
  type                  String    // text | screenshot | divider | task | section
  position              Int       // порядок блока
  parentId              String?   @map("parent_id")
  data                  Json      // содержимое блока (title, content, images, layout, etc.)
  version               Int       @default(1)
  taskCompletedAt         DateTime? @map("task_completed_at")
  taskCompletedByUserId   String?   @map("task_completed_by_user_id")
  taskCompletionNotes     String?   @map("task_completion_notes")
  taskCompletionImages    Json?     @map("task_completion_images")
  taskCompletionLayout    String?   @map("task_completion_layout")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  parent    ReportBlock?  @relation("BlockChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  ReportBlock[] @relation("BlockChildren")

  @@map("report_blocks")
  @@index([reportId])
  @@index([parentId])
  @@unique([reportId, position])
}

// Справочник ручных исполнителей задач (без учётной записи)
model TaskPerson {
  id        String   @id @default(uuid())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("task_people")
  @@index([isActive, lastName, firstName])
}

// Метаданные загруженных файлов (изображения)
model Upload {
  id        String   @id @default(uuid())
  reportId  String?  @map("report_id")
  groupId   String   @map("group_id")
  filename  String
  path      String   @unique // относительный путь на сервере
  mimeType  String   @map("mime_type")
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  group      ReportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("uploads")
  @@index([reportId])
  @@index([groupId])
}
